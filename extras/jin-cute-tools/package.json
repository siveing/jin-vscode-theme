{
  "name": "jin-cute-tools",
  "displayName": "Jin Cute Tools",
  "description": "Personal companion to Jin Cute Theme: Sublime-style Cmd+R / Cmd+I and animated cursor settings. Installed locally, not published.",
  "version": "0.1.0",
  "publisher": "local",
  "private": true,
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Keymaps",
    "Other"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "jinCute.goToFunction",
        "title": "Go to Function in File",
        "category": "Jin Cute"
      }
    ],
    "keybindings": [
      {
        "command": "jinCute.goToFunction",
        "key": "ctrl+r",
        "mac": "cmd+r",
        "when": "editorTextFocus"
      },
      {
        "command": "editor.action.goToImplementation",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "editorHasImplementationProvider && editorTextFocus && !isInEmbeddedEditor"
      }
    ],
    "configurationDefaults": {
      "editor.cursorStyle": "line",
      "editor.cursorWidth": 2,
      "editor.cursorBlinking": "expand",
      "editor.cursorSmoothCaretAnimation": "on",
      "editor.smoothScrolling": true,
      "editor.renderWhitespace": "boundary",
      "editor.guides.indentation": true,
      "editor.guides.highlightActiveIndentation": true,
      "editor.guides.bracketPairs": "active",
      "editor.bracketPairColorization.enabled": true,
      "workbench.list.smoothScrolling": true,
      "terminal.integrated.smoothScrolling": true,
      "terminal.integrated.cursorStyle": "line",
      "terminal.integrated.cursorBlinking": true
    }
  }
}
