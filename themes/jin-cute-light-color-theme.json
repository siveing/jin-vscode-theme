    "struct": "#1c7465",
    "typeParameter": "#1c7465",
    "class.defaultLibrary": "#1c7465",
    "function": "#1f5fbf",
    "method": "#1f5fbf",
    "function.defaultLibrary": "#1f5fbf",
    "macro": "#6a3fc0",
    "decorator": "#6a3fc0",
    "variable": "#3b2530",
    "variable.readonly": "#3b2530",
    "parameter": {
