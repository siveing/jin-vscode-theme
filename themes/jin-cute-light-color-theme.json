  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#8a7380",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc comment tags",
      "scope": [
        "storage.type.class.jsdoc",
        "punctuation.definition.block.tag.jsdoc",
        "comment.block.documentation storage.type"
      ],
      "settings": {
        "foreground": "#b52f78",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc comment names",
      "scope": [
        "comment.block.documentation variable",
        "comment.block.documentation entity.name.type",
        "variable.other.jsdoc"
      ],
      "settings": {
        "foreground": "#a03ab8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "keyword.operator.word"
      ],
      "settings": {
        "foreground": "#b52f78",
        "fontStyle": ""
      }
    },
    {
      "name": "Control flow & imports",
      "scope": [
        "keyword.control",
        "keyword.operator.import",
        "keyword.other.import",
        "keyword.other.using"
      ],
      "settings": {
        "foreground": "#c41a5c",
        "fontStyle": ""
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#5e4552"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#6e5562"
      }
    },
    {
      "name": "Functions & methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic",
        "variable.function",
        "meta.require"
      ],
      "settings": {
        "foreground": "#1f5fbf"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string",
        "markup.inline.raw",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#2e7d32"
      }
    },
    {
      "name": "Template expressions",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded",
        "punctuation.section.interpolation"
      ],
      "settings": {
        "foreground": "#b52f78"
      }
    },
    {
      "name": "Embedded code",
      "scope": [
        "meta.template.expression",
        "meta.embedded",
        "meta.interpolation"
      ],
      "settings": {
        "foreground": "#3b2530"
      }
    },
    {
      "name": "Escapes & placeholders",
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder",
        "constant.character.format.placeholder"
      ],
      "settings": {
        "foreground": "#c41a5c"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp",
        "constant.other.character-class.regexp",
        "keyword.operator.quantifier.regexp"
      ],
      "settings": {
        "foreground": "#1c7465"
      }
    },
    {
      "name": "Numbers & units",
      "scope": [
        "constant.numeric",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#b8323c"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant.language",
        "constant.character",
        "constant.other",
        "variable.other.constant",
        "variable.other.enummember",
        "support.constant"
      ],
      "settings": {
        "foreground": "#b8323c"
      }
    },
    {
      "name": "Types & classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "storage.type.primitive",
        "storage.type.built-in",
        "entity.name.type.parameter"
      ],
      "settings": {
        "foreground": "#1c7465"
      }
    },
    {
      "name": "Namespaces & modules",
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "entity.name.type.module",
        "entity.name.package",
        "storage.modifier.import.java"
      ],
      "settings": {
        "foreground": "#1c7465"
      }
    },
    {
      "name": "Decorators & macros",
      "scope": [
        "meta.decorator entity.name.function",
        "entity.name.function.decorator",
        "punctuation.decorator",
        "punctuation.definition.decorator",
        "storage.type.annotation",
        "entity.name.function.macro",
        "entity.name.function.preprocessor"
      ],
      "settings": {
        "foreground": "#6a3fc0"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#3b2530"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "meta.parameters variable.other"
      ],
      "settings": {
        "foreground": "#a03ab8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "this / self",
      "scope": [
        "variable.language",
        "variable.parameter.function.language.special.self",
        "variable.parameter.function.language.special.cls"
      ],
      "settings": {
        "foreground": "#c41a5c",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Properties & keys",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key",
        "support.type.property-name",
        "entity.name.tag.yaml",
        "variable.other.member"
      ],
      "settings": {
        "foreground": "#0e7490"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#c41a5c"
      }
    },
    {
      "name": "Components",
