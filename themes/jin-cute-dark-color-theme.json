        "fontStyle": "strikethrough"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#7fd1c0",
    "type": "#7fd1c0",
    "class": "#7fd1c0",
    "enum": "#7fd1c0",
    "interface": "#7fd1c0",
    "struct": "#7fd1c0",
    "typeParameter": "#7fd1c0",
    "class.defaultLibrary": "#7fd1c0",
    "function": "#82c4f5",
    "method": "#82c4f5",
    "function.defaultLibrary": "#82c4f5",
    "macro": "#c3b6f5",
    "decorator": "#c3b6f5",
    "variable": "#e6e0e3",
    "variable.readonly": "#e6e0e3",
    "parameter": {
      "foreground": "#d8cb8e",
      "italic": true
    },
    "property": "#c3b6f5",
    "enumMember": "#f2707a",
    "selfParameter": {
