{
  "name": "jin-cute-theme",
  "displayName": "Jin Cute Theme",
  "description": "A cute pink color theme for VS Code: black dark mode and blush light mode.",
  "version": "0.1.0",
  "publisher": "local",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Themes",
    "Keymaps"
  ],
  "main": "./extension.js",
  "keywords": [
    "theme",
    "dark",
    "light",
    "pink",
    "cute",
    "black"
  ],
  "contributes": {
    "commands": [
      {
        "command": "jinCute.goToFunction",
        "title": "Go to Function in File",
        "category": "Jin Cute"
      }
    ],
    "keybindings": [
      {
        "command": "jinCute.goToFunction",
        "key": "ctrl+r",
        "mac": "cmd+r",
        "when": "editorTextFocus"
      },
      {
        "command": "editor.action.goToImplementation",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "editorHasImplementationProvider && editorTextFocus && !isInEmbeddedEditor"
      }
    ],
    "configurationDefaults": {
      "editor.cursorStyle": "line",
      "editor.cursorWidth": 2,
      "editor.cursorBlinking": "expand",
      "editor.cursorSmoothCaretAnimation": "on",
      "editor.smoothScrolling": true,
      "editor.renderWhitespace": "boundary",
      "editor.guides.indentation": true,
      "editor.guides.highlightActiveIndentation": true,
      "editor.guides.bracketPairs": "active",
      "editor.bracketPairColorization.enabled": true,
      "workbench.list.smoothScrolling": true,
      "terminal.integrated.smoothScrolling": true,
      "terminal.integrated.cursorStyle": "line",
      "terminal.integrated.cursorBlinking": true
    },
    "themes": [
      {
        "label": "Jin Cute Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/jin-cute-dark-color-theme.json"
      },
      {
        "label": "Jin Cute Light",
        "uiTheme": "vs",
        "path": "./themes/jin-cute-light-color-theme.json"
      }
    ]
  },
  "scripts": {
    "build": "node src/build.js",
    "watch": "node src/build.js --watch",
    "package": "npx --yes @vscode/vsce package --allow-missing-repository --skip-license",
    "install-theme": "npm run build && npm run package && code --install-extension jin-cute-theme-0.1.0.vsix --force"
  }
}
