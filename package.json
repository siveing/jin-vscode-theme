{
  "name": "jin-cute-theme",
  "displayName": "Jin Cute Theme",
  "description": "A cute pink color theme for VS Code: true black dark mode and soft blush light mode.",
  "version": "0.2.1",
  "publisher": "siveing",
  "author": {
    "name": "Siveing"
  },
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#131315",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/siveing/jin-vscode-theme.git"
  },
  "homepage": "https://github.com/siveing/jin-vscode-theme#readme",
  "bugs": {
    "url": "https://github.com/siveing/jin-vscode-theme/issues"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "color theme",
    "dark",
    "light",
    "black",
    "pink",
    "cute"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Jin Cute Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/jin-cute-dark-color-theme.json"
      },
      {
        "label": "Jin Cute Light",
        "uiTheme": "vs",
        "path": "./themes/jin-cute-light-color-theme.json"
      }
    ]
  },
  "scripts": {
    "build": "node src/build.js",
    "watch": "node src/build.js --watch",
    "package": "npm run build && npx --yes @vscode/vsce package",
    "install-theme": "npm run package && code --install-extension jin-cute-theme-$npm_package_version.vsix --force",
    "install-tools": "cd extras/jin-cute-tools && npx --yes @vscode/vsce package --allow-missing-repository --skip-license -o jin-cute-tools.vsix && code --install-extension jin-cute-tools.vsix --force",
    "publish": "npm run build && npx --yes @vscode/vsce publish"
  }
}
